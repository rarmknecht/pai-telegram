# Keep comments on their own line, never trailing a value. Bun strips a
# trailing `# ...`, but systemd's EnvironmentFile= does not — it reads the
# comment as part of the value, and this repo has a systemd unit intended for
# later use. A copied .env would then fail startup with e.g. "SESSION_CWD does
# not exist".

BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
MIA_VOICE_ID=your_elevenlabs_voice_id_here
WHISPER_VENV=/home/YOUR_USER/Gitea/pai-telegram/whisper-env

# Working dir for Claude Code sessions (default: $HOME)
SESSION_CWD=/absolute/path/to/your/projects
